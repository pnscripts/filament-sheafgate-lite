{
    "name": "pnscripts/sheafgate-lite",
    "description": "Sheafgate Lite: import XLSX, ODS and CSV files through Filament's own importer, with column mapping, validation, queued chunks and the failed-rows download unchanged.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filamentphp",
        "filament-plugin",
        "import",
        "importer",
        "excel",
        "xlsx",
        "ods",
        "csv",
        "spreadsheet"
    ],
    "homepage": "https://github.com/pnscripts/filament-sheafgate-lite",
    "authors": [
        {
            "name": "PN Scripts",
            "email": "office@pnscripts.com",
            "homepage": "https://pnscripts.com"
        }
    ],
    "support": {
        "email": "office@pnscripts.com",
        "issues": "https://github.com/pnscripts/filament-sheafgate-lite/issues",
        "source": "https://github.com/pnscripts/filament-sheafgate-lite",
        "docs": "https://github.com/pnscripts/filament-sheafgate-lite#readme"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://pnscripts.com/marketplace/filament-sheafgate"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.8",
        "illuminate/support": "^12.0|^13.0",
        "openspout/openspout": "^4.23"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "PNScripts\\SheafgateLite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PNScripts\\SheafgateLite\\Tests\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "PNScripts\\SheafgateLite\\SheafgateLiteServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
